# Creative Research Report — copy to .env and fill in values
# cp .env.example .env

# =============================================================================
# REQUIRED (minimal: OpenAI or Gemini for pipeline)
# =============================================================================
# OpenAI: primary for keywords, report, scripts. Gemini used as fallback if OpenAI fails.
OPENAI_API_KEY=sk-...

# Product URL for pipeline (run_pipeline_v2.py, API)
PRODUCT_URL=https://www.flipkart.com/your-product/p/...

# =============================================================================
# SCRAPING
# =============================================================================
# Apify (TikTok, Instagram) — apify.com
# TikTok: Apify downloads videos when tiktok_download_videos=true (default). Requires APIFY_API_TOKEN.
APIFY_API_TOKEN=apify_api_...
# SKIP_APIFY=1

# TikTok yt-dlp fallback: set to "chrome", "firefox", "safari" to use browser cookies (close browser first)
# TIKTOK_COOKIES_FROM_BROWSER=chrome

# YouTube Data API v3 — console.cloud.google.com
YOUTUBE_API_KEY=...
# or
GOOGLE_API_KEY=...

# Reddit: public JSON API (no key needed)

# Tavily (competitor research) — tavily.com
TAVILY_API_KEY=tvly-...

# =============================================================================
# VIDEO ANALYSIS (Gemini)
# =============================================================================
# ai.google.dev
GEMINI_API_KEY=...
# or reuse GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BATCH_DELAY=3
# SKIP_GEMINI_ANALYSIS=1

# =============================================================================
# DJANGO API
# =============================================================================
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: PostgreSQL (default) or SQLite
# USE_SQLITE=1
POSTGRES_DB=product_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Supabase PostgreSQL (optional — when set, overrides POSTGRES_*)
# Direct connection uses IPv6 by default. If your environment doesn't support IPv6, use
# Supavisor SESSION MODE instead (IPv4-compatible). Get it from Supabase Dashboard:
#   Connect → Session mode → Copy URI
# Session mode format: postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_DB_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# or DATABASE_URL=postgres://...

# Celery (async pipeline) — requires Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# S3 / SUPABASE STORAGE (video uploads & presigned URLs)
# =============================================================================
# Required for pipeline video upload to S3 and presigned URLs in /api/pipeline/status/<job_id>/
# Supabase Storage: Project Settings → Storage → S3 Access Keys
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_STORAGE_BUCKET_NAME=videos
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3

# =============================================================================
# CORS & NGROK (when sharing API via ngrok)
# =============================================================================
# Add ngrok host to DJANGO_ALLOWED_HOSTS
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-subdomain.ngrok-free.dev
# NGROK_SHARING=true
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# OPTIONAL
# =============================================================================
# MCP server over HTTP
# CREATIVE_RESEARCH_MCP_HTTP=1

# API test script base URL
# API_BASE_URL=http://localhost:8000
